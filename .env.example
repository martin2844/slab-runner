RUNNER_HOST=127.0.0.1
RUNNER_PORT=6990
CODEX_BIN=codex
# Dedicated persistent Codex state for Slab Runner. Its managed config contains
# no global MCP servers; slab-agents supplies Work, Docs, and integrations per run.
# RUNNER_CODEX_HOME=/home/you/.local/state/slab-runner/codex
# RUNNER_TOKEN=
# Opt in only for local debugging. Full sanitized tool payloads are otherwise
# represented by a 500-character preview and byte/token metrics.
RUNNER_OBSERVABILITY_FULL_PAYLOADS=false
